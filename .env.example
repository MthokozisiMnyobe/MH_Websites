# Application
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/MH_Websites
APP_BASE_PATH=/MH_Websites
APP_CANONICAL_URL=https://mhwebsites.co.za
APP_TIMEZONE=Africa/Johannesburg
APP_SESSION_NAME=mh_websites_session
APP_KEY=
# Prefer a non-public writable path in production. The local default is protected by storage/.htaccess.
SESSION_SAVE_PATH=

# Database (optional until Checkpoint 5)
DB_HOST=
DB_PORT=3306
DB_NAME=mh_websites
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Email notifications (optional until Checkpoint 5)
MAIL_ENABLED=false
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MH Websites"
MAIL_NOTIFICATION_ADDRESS=
MAIL_TIMEOUT_SECONDS=10

# Submission controls
RATE_LIMIT_ATTEMPTS=6
RATE_LIMIT_WINDOW_SECONDS=900
SUBMISSION_MAX_BODY_BYTES=65536
SUBMISSION_MAX_BASKET_LINES=50
IDEMPOTENCY_TTL_SECONDS=3600
CONFIRMATION_TTL_SECONDS=1800

# Comma-separated proxy IPs explicitly trusted to supply X-Forwarded-For.
# Leave empty for direct local/production connections.
TRUSTED_PROXIES=

# Optional customer-contact integration
WHATSAPP_NUMBER=
